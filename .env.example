# --- Copy to .env and fill in. .env is gitignored; never commit real values. ---

# Absolute path to the Obsidian vault root (required).
VAULT_PATH=/path/to/your/Obsidian/Vault

# Auth mode: token | github | none
#   token  — static Bearer token (works with Claude Code `--header`, NOT the
#            claude.ai / Claude Desktop custom-connector UI, which has no header field)
#   github — GitHub OAuth (works with Claude Desktop / claude.ai remote connectors)
#   none   — no auth (only safe on a fully trusted/private network)
# If left blank, it is inferred: github if GITHUB_CLIENT_ID is set, else token if
# MCP_AUTH_TOKEN is set, else none.
AUTH_MODE=

# --- token mode ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# --- github mode (OAuth) ---
# Register an OAuth App at https://github.com/settings/developers
#   Homepage URL:            https://your-public-host
#   Authorization callback:  https://your-public-host/auth/callback
# Then paste the credentials here. BASE_URL must be the PUBLIC https URL your
# reverse proxy serves (used in OAuth metadata + redirects).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=
# Comma-separated GitHub logins allowed to connect. REQUIRED in github mode —
# OAuth proves identity, this decides who is authorized. Fail-closed.
GITHUB_ALLOWED_USERS=

# HTTP bind. Keep host on localhost and let your reverse proxy / TLS terminate
# the public domain:port and forward to this address.
MCP_HOST=127.0.0.1
MCP_PORT=8848
MCP_PATH=/mcp

# Optional external helper binaries. Leave blank to disable the matching tool.
# These are looked up on PATH if a bare name is given.

# Warm semantic-search front-end, called as `<bin> "<query>" -n <limit>`.
# Preferred over QMD_BIN for `vault_search mode=semantic` when set.
FAST_SEARCH_BIN=

QMD_BIN=qmd
WIKI_QUERY_BIN=wiki-query
SAVE_LINK_BIN=obsidian-save-link

# Optional: command run to rebuild the wiki index when a tool is called with
# rebuild_index=true. Leave blank to disable index rebuilds entirely.
INDEX_REBUILD_CMD=

# --- transcript-done webhook (STT-web → auto Meeting MOM) ------------------
# When a raw transcript lands in the vault, STT-web POSTs to
#   /hooks/transcript-done   (same process as MCP, separate HTTP door)
# and we run a headless `claude -p` to synthesise the Meeting MOM.
#
# The route is ONLY mounted when TRANSCRIPT_HOOK_SECRET is set — no secret means
# there is no unauthenticated way to fire the headless agent. Leave blank to
# disable the webhook entirely.
#
# Signature contract (ElevenLabs/Stripe-style — what STT-web sends): header
#   X-Transcript-Signature: t=<unix ts>,v0=<hex>
# where hex = HMAC-SHA256(TRANSCRIPT_HOOK_SECRET, "<t>.<raw request body>").
# (A plain `sha256=<hex>` over the body alone is also accepted as a fallback.)
# The secret here MUST equal STT-web's TRANSCRIPT_HOOK_SECRET. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Request body (JSON): {"transcript_id": 35,
#                       "file_path": "<vault-relative raw .md>",
#                       "meeting_date": "2026-07-04"}   ("path" accepted as alias)
TRANSCRIPT_HOOK_SECRET=

# Headless Claude Code binary invoked by the webhook (looked up on PATH).
CLAUDE_BIN=claude
# Hard ceiling on a single headless run, in seconds (default 1800 = 30m). The
# process is killed and the transcript marked `failed` if it overruns.
TRANSCRIPT_HOOK_TIMEOUT=1800
# Tools the headless agent may use (comma-separated). Must include the vault
# read/write tools of your configured MCP server.
TRANSCRIPT_ALLOWED_TOOLS=mcp__thomas__vault_read,mcp__thomas__vault_write
# Optional --mcp-config path passed to `claude -p` so the headless run can reach
# this MCP server. Leave blank if the user's default config already has it.
TRANSCRIPT_MCP_CONFIG=
# Vault-relative cleanup-prompt guide the agent reads for the MOM rules.
TRANSCRIPT_PROMPT_GUIDE=10-Projects/SK에코플랜트 AI Transformation/Operating-Model/화자분리 전사본 기반 회의록 정리 프롬프트.md
# Vault-relative root that submitted transcript paths must sit under (guardrail).
TRANSCRIPT_ROOT=10-Projects/SK에코플랜트 AI Transformation/Transcripts
